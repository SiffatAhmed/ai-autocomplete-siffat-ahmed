{
  "name": "ai-autocomplete-siffat-ahmed",
  "displayName": "AI Autocomplete",
  "description": "AI-powered code completions for JavaScript, TypeScript, and Dart",
  "icon": "my-extension-icon.png",
  "version": "0.1.2",
  "publisher": "siffat-ahmed",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "AI"
  ],
  "keywords": [
    "claude",
    "ai",
    "autocomplete",
    "javascript",
    "typescript",
    "dart",
    "flutter"
  ],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/SiffatAhmed/ai-autocomplete-siffat-ahmed"
  },
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:dart"
  ],
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^3.7.1",
    "typescript": "^5.3.0"
  },
  "contributes": {
    "configuration": {
      "title": "AI Autocomplete",
      "properties": {
        "aiAutocomplete.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable AI autocomplete for JS/TS/Dart"
        },
        "aiAutocomplete.model": {
          "type": "string",
          "default": "claude-3-5-haiku-20241022",
          "description": "Claude model to use"
        },
        "aiAutocomplete.maxTokens": {
          "type": "number",
          "default": 300,
          "minimum": 100,
          "maximum": 1000,
          "description": "Maximum tokens for completion"
        },
        "aiAutocomplete.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 1,
          "description": "Temperature for completions (0=deterministic, 1=creative)"
        },
        "aiAutocomplete.debounceDelay": {
          "type": "number",
          "default": 300,
          "minimum": 100,
          "maximum": 2000,
          "description": "Delay in ms before requesting completion"
        },
        "aiAutocomplete.contextLinesBefore": {
          "type": "number",
          "default": 30,
          "minimum": 10,
          "maximum": 100,
          "description": "Number of lines before cursor to include as context"
        },
        "aiAutocomplete.contextLinesAfter": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 50,
          "description": "Number of lines after cursor to include as context"
        }
      }
    },
    "commands": [
      {
        "command": "aiAutocomplete.setApiKey",
        "title": "AI: Set API Key"
      },
      {
        "command": "aiAutocomplete.selectModel",
        "title": "AI: Select Model"
      },
      {
        "command": "aiAutocomplete.toggleEnabled",
        "title": "AI: Toggle Autocomplete"
      },
      {
        "command": "aiAutocomplete.clearCache",
        "title": "AI: Clear Completion Cache"
      },
      {
        "command": "aiAutocomplete.triggerCompletion",
        "title": "AI: Trigger Completion Manually"
      },
      {
        "command": "aiAutocomplete.acceptCompletion",
        "title": "AI: Accept Completion (Tab)"
      },
      {
        "command": "aiAutocomplete.rejectCompletion",
        "title": "AI: Reject Completion (Escape)"
      }
    ],
    "keybindings": [
      {
        "command": "aiAutocomplete.triggerCompletion",
        "key": "ctrl+shift+space",
        "mac": "cmd+shift+space",
        "when": "editorTextFocus && (editorLangId == javascript || editorLangId == typescript || editorLangId == javascriptreact || editorLangId == typescriptreact || editorLangId == dart)"
      },
      {
        "command": "aiAutocomplete.acceptCompletion",
        "key": "tab",
        "when": "(aiSuggestionVisible || inlineSuggestionsVisible) && editorTextFocus && (editorLangId == javascript || editorLangId == typescript || editorLangId == javascriptreact || editorLangId == typescriptreact || editorLangId == dart)"
      },
      {
        "command": "aiAutocomplete.rejectCompletion",
        "key": "escape",
        "when": "aiSuggestionVisible && editorTextFocus && (editorLangId == javascript || editorLangId == typescript || editorLangId == javascriptreact || editorLangId == typescriptreact || editorLangId == dart)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./out/test/runTest.js"
  }
}
